# ── Stage 1: builder ─────────────────────────────────────────────────────────
FROM python:3.13-slim AS builder
WORKDIR /build
RUN pip install --upgrade pip
COPY pyproject.toml .
RUN pip wheel --no-cache-dir -w /wheels . && \
    pip wheel --no-cache-dir -w /wheels "cython>=3" "setuptools>=70"

# ── Stage 2: compiler ────────────────────────────────────────────────────────
FROM python:3.13-slim AS compiler
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libc6-dev && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir /wheels/*.whl
COPY core/ ./core/
COPY setup_cython.py .
RUN python setup_cython.py build_ext --inplace && \
    find core/security core/license -name "*.py" \
      -not -name "__init__.py" -delete && \
    find core/ -name "*.c" -delete

# ── Stage 3: runtime-worker ──────────────────────────────────────────────────
# Final image: core + worker only, no app/ (FastAPI code)
FROM python:3.13-slim AS runtime
WORKDIR /app
COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir /wheels/*.whl && rm -rf /wheels
# Compiled core/
COPY --from=compiler /app/core ./core
# Celery worker code (no app/, no alembic/)
COPY worker/ ./worker/
# WORKER_QUEUES and WORKER_CONCURRENCY injected by docker-compose
CMD ["sh", "-c", "celery -A worker.celery_app worker -Q ${WORKER_QUEUES:-notify,maintenance} -c ${WORKER_CONCURRENCY:-4} --loglevel=info"]
